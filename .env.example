# App
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001

# Database (local or Supabase Postgres)
DATABASE_URL=postgresql://auth:auth@localhost:5433/auth?schema=public
DIRECT_URL=postgresql://auth:auth@localhost:5433/auth?schema=public

# Supabase project metadata (optional — Prisma uses DATABASE_URL / DIRECT_URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Better Auth / JWT (bootstrap only)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=http://localhost:3001
JWT_EXPIRATION=15m

# Encrypt per-app OAuth secrets at rest
MASTER_ENCRYPTION_KEY=change-me-master-encryption-key-32chars

# Admin dashboard (x-admin-api-key / login field)
ADMIN_API_KEY=change-me-admin-api-key

# Google/GitHub credentials: configure per application in Admin UI
# (not in this file — supports many apps / environments)
